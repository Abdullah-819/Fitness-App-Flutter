<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window shown while the process starts: brand purple in light AND dark
         mode (the default template used white / black, which flashed). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_purple</item>
        <item name="android:navigationBarColor">@color/launch_purple</item>
    </style>
    <!-- Window behind the Flutter UI once the engine has started. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_purple</item>
    </style>
</resources>
